# Backend Environment Variables
# Copy this file to .env and fill in your actual values.
# Lines marked [NEW] were added in Phase 1.

# =============================================================================
# Server
# =============================================================================
PORT=5000
# [NEW] Comma-separated CORS origins. Falls back to hardcoded list if not set.
CORS_ORIGINS=http://localhost:3000

# =============================================================================
# Database
# =============================================================================
MONGODB_URI=your_mongodb_connection_uri_here

# =============================================================================
# Authentication
# =============================================================================
JWT_SECRET=your_jwt_secret_here
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Enable/Disable developer backdoor login (true/false).
# WARNING: NEVER enable this in production!
ENABLE_DEV_LOGIN=true

# =============================================================================
# LLM Provider Layer [NEW]
# =============================================================================

# Comma-separated provider chain. Providers are tried in order.
# Supported: groq, gemini
LLM_PROVIDER_ORDER=groq,gemini

# Per-call timeout in milliseconds before falling back to the next provider.
LLM_TIMEOUT_MS=10000

# --- Groq (primary, free tier) ---
# Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Groq model for fast conversation turns
LLM_MODEL_FAST=llama-3.1-8b-instant

# Groq model for heavier tasks (overall feedback, reports)
LLM_MODEL_STRONG=llama-3.1-70b-versatile

# --- Gemini (fallback) ---
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# Gemini model for fast turns
GEMINI_MODEL_FAST=gemini-3.5-flash

# Gemini model for heavy tasks
GEMINI_MODEL_STRONG=gemini-3.5-flash

# =============================================================================
# Interview session [NEW]
# =============================================================================

# Number of questions per interview session.
MAX_QUESTIONS_PER_INTERVIEW=5

# [NEW Phase 3] Maximum follow-up probes allowed per question
MAX_FOLLOWUPS_PER_QUESTION=2

# [NEW Phase 3] Maximum progressive hints allowed per DSA coding question
MAX_HINTS_PER_QUESTION=2

# [NEW Phase 4] Optional external sandboxed code execution runner (e.g. Piston)
# Default is disabled (client-side execution via Web Worker/Pyodide is used)
CODE_RUNNER_URL=

# When true, raw audio/video blobs are sent to Gemini multimodal (legacy path).
# When false (default), only the transcript text + speech metrics are sent.
LEGACY_MEDIA_EVAL=false

# =============================================================================
# Rate limiting [NEW]
# =============================================================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AI_RATE_LIMIT_MAX=20

# =============================================================================
# RAG / Embeddings
# =============================================================================
RAG_FEEDBACK_ENABLED=false
RAG_FEEDBACK_TOP_K=3
RAG_EMBEDDING_TTL_MS=300000

# Embedding provider (future-proofing). Currently only 'gemini' is used.
EMBEDDINGS_PROVIDER=gemini
GOOGLE_EMBEDDING_MODEL=text-embedding-004
